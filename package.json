{
  "name": "wohin-monorepo",
  "private": true,
  "workspaces": [
    "wohin-cms",
    "wohin-backend",
    "wohin-site"
  ],
  "scripts": {
    "dev:infra": "bun x concurrently -n \"cms,backend\" -c \"cyan,yellow\" \"bun run --cwd wohin-cms dev\" \"bun run --cwd wohin-backend dev\"",
    "dev:cms": "bun run --cwd wohin-cms dev",
    "dev:backend": "bun run --cwd wohin-backend dev",
    "dev:site": "bun run --cwd wohin-site dev",
    "dev:app": "cd wohin-app && flutter run",
    "dev:mac": "cd wohin-app && flutter run -d macos",
    "install:all": "bun install"
  }
}